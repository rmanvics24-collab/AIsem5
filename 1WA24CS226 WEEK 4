
import random

N = 4

def cost(board):
    conflicts = 0
    for i in range(N):
        for j in range(i + 1, N):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1
    return conflicts

def hill_climbing():
    board = [random.randint(0, N - 1) for _ in range(N)]

    while True:
        current_cost = cost(board)
        print("Board:", board, "Cost:", current_cost)

        if current_cost == 0:
            print("Solution found!")
            return board

        best_board = board[:]
        best_cost = current_cost

        for col in range(N):
            for row in range(N):
                if row != board[col]:
                    neighbor = board[:]
                    neighbor[col] = row
                    neighbor_cost = cost(neighbor)

                    if neighbor_cost < best_cost:
                        best_board = neighbor
                        best_cost = neighbor_cost

        if best_cost >= current_cost:
            print("Local minimum reached. Restarting...\n")
            board = [random.randint(0, N - 1) for _ in range(N)]
        else:
            board = best_board

def display(board):
    for row in range(N):
        print(" ".join("Q" if board[col] == row else "."
                       for col in range(N)))

solution = hill_climbing()
display(solution)







