import heapq

goal = (1,2,3,4,5,6,7,8,0)

def misplaced(s):
    return sum(s[i] != goal[i] and s[i] != 0 for i in range(9))

def manhattan(s):
    d = 0
    for i, x in enumerate(s):
        if x != 0:
            j = goal.index(x)
            d += abs(i//3-j//3) + abs(i%3-j%3)
    return d

def moves(s):
    p = s.index(0)
    r, c = divmod(p, 3)

    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        nr, nc = r+dr, c+dc
        if 0 <= nr < 3 and 0 <= nc < 3:
            q = nr*3+nc
            a = list(s)
            a[p], a[q] = a[q], a[p]
            yield tuple(a)

def astar(start, h):
    pq = [(h(start), 0, start, [])]
    visited = set()

    while pq:
        f, g, s, path = heapq.heappop(pq)

        if s == goal:
            return path + [s]

        if s in visited:
            continue
        visited.add(s)

        for n in moves(s):
            if n not in visited:
                heapq.heappush(pq, (g+1+h(n), g+1, n, path+[s]))

    return []

# Input
start = tuple(map(int, input("Enter 9 numbers: ").split()))

if len(start) != 9 or set(start) != set(range(9)):
    print("Enter exactly 9 numbers from 0 to 8.")
else:
    for name, h in [("Misplaced Tiles", misplaced),
                    ("Manhattan Distance", manhattan)]:

        print("\n" + name)
        solution = astar(start, h)

        for s in solution:
            print(s[:3])
            print(s[3:6])
            print(s[6:])
            print()




